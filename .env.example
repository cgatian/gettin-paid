# =============================================================================
# gettin-paid — environment template
#
# Quick start (local):
#   cp .env.example .env
#   cp .env backend/.env
#   cp frontend/.env.example frontend/.env
#   (edit frontend/.env if your API is not on port 4000)
#
# Prisma and Nest resolve env from the backend package directory, so
# backend/.env must exist (or export DATABASE_URL etc. in your shell).
# Vite reads frontend/.env and frontend/.env.local (see Vite docs).
# =============================================================================

# --- Database (required for API and Prisma) ---
# Matches docker-compose.yml: user postgres, password postgres, db gettin_paid
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gettin_paid"

# --- API (NestJS) ---
PORT=4000
# Allowed browser origin(s) for CORS; comma-separated for multiple apps
FRONTEND_URL=http://localhost:3000

# --- PriceCharting (optional) ---
# Required for POST …/refresh-market and sync-on-create; leave empty to skip
PRICECHARTING_API_TOKEN=
# Minimum milliseconds between outbound PriceCharting requests (backend enforces ≥4000)
PRICECHARTING_MIN_INTERVAL_MS=4000

# --- Frontend (Vite; only variables prefixed with VITE_ are exposed to the app) ---
# Base URL of the API (no path suffix; the client calls /api/...)
VITE_API_URL=http://localhost:4000

# --- Optional ---
# NODE_ENV=development

# =============================================================================
# Railway (two services: web + API — repo root as root directory for both)
#
# Web service (uses repo railway.toml):
#   Build-time: VITE_API_URL=https://<your-api-service>.up.railway.app
#   Railway sets PORT; Nitro respects PORT for the SSR server.
#
# API service (set dashboard “Config as code” to backend/railway.toml):
#   DATABASE_URL — from Railway Postgres (reference variable)
#   PORT — injected by Railway (Nest reads process.env.PORT)
#   FRONTEND_URL=https://<your-web-service>.up.railway.app  (CORS; comma‑separate for multiple)
#   PRICECHARTING_* — optional
#   preDeploy runs: pnpm run db:migrate (see backend/railway.toml)
# =============================================================================
