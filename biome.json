{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"frontend/**/*.{ts,tsx}",
			"packages/**/*.ts",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/node_modules",
			"!**/dist",
			"!**/.output",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!frontend/styled-system"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
