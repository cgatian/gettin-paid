{
  "name": "@gettin-paid/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "pnpm --filter @gettin-paid/backend exec prisma migrate deploy && node dist/main.js",
    "start:dev": "pnpm dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "import:resolve-upcs": "tsx src/oneoff/resolve-listing-upcs.run.ts",
    "import:gen-sql": "tsx src/oneoff/generate-game-edition-migration.run.ts",
    "import:refresh-snapshots": "tsx src/oneoff/bulk-refresh-snapshots.run.ts",
    "fetch-covers": "tsx src/oneoff/fetch-all-covers.run.ts"
  },
  "dependencies": {
    "@gettin-paid/shared": "workspace:*",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cheerio": "1.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "5.0.6",
    "@types/node": "22.19.17",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
