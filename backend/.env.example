# Backend + Prisma — copy to backend/.env
# (See repository root .env.example for full-stack notes.)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gettin_paid"

PORT=4000
FRONTEND_URL=http://localhost:3000

PRICECHARTING_API_TOKEN=
# Minimum milliseconds between PriceCharting HTTP calls (app enforces ≥2000; higher is safer)
PRICECHARTING_MIN_INTERVAL_MS=2000

# Absolute path for scraped cover images (default: <cwd>/storage/covers). On Railway, point
# this at a path on a mounted volume so covers survive deploys, e.g. COVER_STORAGE_PATH=/data/covers
# COVER_STORAGE_PATH=

# Pause between editions when the server runs fetch-all-covers (ms; minimum 2000 in API logic)
# COVER_SCRAPE_MIN_INTERVAL_MS=2000

# One-off import scripts (see package.json import:*): Paste list to data/games.txt, then
# pnpm import:resolve-upcs -- --input data/games.txt
